{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar StringLab (Streamlit)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "app.py",
                "--server.port=8501"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Ejecutar Pruebas Unitarias",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_modulos.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
